{
  "entity": {
    "button": {
      "toss_treat": { "default": "mdi:bone" },
      "treat_sound": { "default": "mdi:bell-ring" }
    },
    "number": {
      "treats_per_day": { "default": "mdi:counter" },
      "min_gap": { "default": "mdi:timer-sand" },
      "double_chance": { "default": "mdi:dice-multiple" },
      "triple_chance": { "default": "mdi:dice-multiple" },
      "bonus_delay": { "default": "mdi:timer-outline" }
    },
    "select": {
      "schedule_mode": {
        "default": "mdi:calendar-clock",
        "state": { "random": "mdi:shuffle-variant" }
      }
    },
    "sensor": {
      "treats_today": { "default": "mdi:bone" },
      "next_treat": { "default": "mdi:clock-outline" }
